# Local development example only. Copy to .env and choose your own passwords.
# Keep .env private; this file must not contain real credentials.
POSTGRES_DB=screcaap_dev
POSTGRES_USER=screcaap_dev
POSTGRES_PASSWORD=change-me-local-db
DATABASE_URL=postgresql+psycopg://screcaap_dev:change-me-local-db@127.0.0.1:5432/screcaap_dev
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=change-me-local-minio
MINIO_SECRET_KEY=change-me-local-minio-secret
MINIO_BUCKET=screcaap-dev
MINIO_SECURE=false
